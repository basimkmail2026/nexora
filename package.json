{
  "name": "nexora-v1",
  "private": true,
  "version": "3.0.2-rc.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @nexora/api\" \"npm run dev -w @nexora/web\"",
    "build": "npm run build -w @nexora/web && npm run build -w @nexora/api",
    "start": "npm run start -w @nexora/api",
    "db:generate": "npm run db:generate -w @nexora/api",
    "db:migrate": "npm run db:migrate -w @nexora/api",
    "db:seed": "npm run db:seed -w @nexora/api",
    "db:push": "npm run db:push -w @nexora/api",
    "db:prepare": "npm run db:push && npm run db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": "20.x"
  }
}
